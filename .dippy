set context-env HCOM_INSTANCE_NAME

# Second repository: the base image docker-nginx-full.
allow-read ~/projects/docker-nginx-full/**
allow-edit ~/projects/docker-nginx-full/**
allow-redirect ~/projects/docker-nginx-full/**
allow git -C ~/projects/docker-nginx-full *
allow git -C ../docker-nginx-full *
ask git -C * push *
ask git -C * clean *
ask git -C * config *

# Project scripts; docs-upload and local-buildx.sh publish (S3, registry).
allow scripts/* *
allow scripts/*/* *
allow ./local-build.sh *
ask scripts/docs-upload *
deny ./local-buildx.sh * "Images are built locally only: use ./local-build.sh"

# Node: lockfile installs, audits, package scripts. Lockfile changes ask.
allow yarn *
allow npm ci *
allow npm audit *
allow npm run *
allow npm test *
deny yarn --cwd * "Run yarn in the package directory: (cd backend && yarn ...)"
deny npm --prefix * "Run npm in the package directory: (cd frontend && npm ...)"
ask yarn|
ask yarn install *
allow yarn install --frozen-lockfile *
allow yarn install --immutable *
allow yarn --frozen-lockfile *
ask yarn add *
ask yarn upgrade *
ask yarn upgrade-interactive *
ask yarn remove *
ask yarn global *
ask yarn config *
ask npm audit fix *
ask * --registry* *
ask * --userconfig* *

# Scanners (trivy is allowed globally).
allow grype *
allow syft *
allow osv-scanner *

# Docker: local builds and disposable test containers only.
allow docker *
deny docker push * "Images are built locally only: do not push them to any registry"
deny docker login * "Images are built locally only: no registry login"
deny docker * --push * "Images are built locally only: drop --push"
deny docker * --privileged * "Containers run unprivileged: drop --privileged"
deny docker * --network host * "Containers use the default network: drop --network host"
deny docker * --network=host * "Containers use the default network: drop --network host"
deny docker * --net host * "Containers use the default network: drop --net host"
deny docker * --net=host * "Containers use the default network: drop --net host"
deny docker * --secret* * "Builds take no secrets: drop --secret"
deny docker * --ssh* * "Builds take no SSH agent: drop --ssh"
deny docker * -v * "Bind-mount only paths inside the two repositories: -v ~/projects/nginx-proxy-manager/...:... or ~/projects/docker-nginx-full/..."
deny docker * --volume* * "Bind-mount only paths inside the two repositories: -v ~/projects/nginx-proxy-manager/...:... or ~/projects/docker-nginx-full/..."
deny docker * --mount* * "Bind-mount only paths inside the two repositories: -v ~/projects/nginx-proxy-manager/...:... or ~/projects/docker-nginx-full/..."
allow docker run * -v ~/projects/nginx-proxy-manager/**:** *
allow docker run * -v ~/projects/docker-nginx-full/**:** *
ask docker system *
ask docker * prune *

# Servers belong to the deploy agent.
deny ssh * "Server work is not your role: hand the image and release note to the deploy agent"
deny scp * "Server work is not your role: hand the image and release note to the deploy agent"
deny rsync * "Server work is not your role: hand the image and release note to the deploy agent"
deny ansible * "Server work is not your role: hand the image and release note to the deploy agent"
deny ansible-playbook * "Server work is not your role: hand the image and release note to the deploy agent"
