{
	"operationId": "createBlockRule",
	"summary": "Create a global block rule",
	"tags": ["block-rules"],
	"security": [
		{
			"bearerAuth": ["block_rules.manage"]
		}
	],
	"requestBody": {
		"description": "Block Rule Payload",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "pattern"],
					"properties": {
						"type": {
							"$ref": "../../../components/block-rule-object.json#/properties/type"
						},
						"pattern": {
							"$ref": "../../../components/block-rule-object.json#/properties/pattern"
						},
						"referer_pattern": {
							"$ref": "../../../components/block-rule-object.json#/properties/referer_pattern"
						},
						"action": {
							"$ref": "../../../components/block-rule-object.json#/properties/action"
						},
						"enabled": {
							"$ref": "../../../components/block-rule-object.json#/properties/enabled"
						},
						"note": {
							"$ref": "../../../components/block-rule-object.json#/properties/note"
						},
						"approved_by": {
							"$ref": "../../../components/block-rule-object.json#/properties/approved_by"
						},
						"meta": {
							"$ref": "../../../components/block-rule-object.json#/properties/meta"
						}
					}
				}
			}
		}
	},
	"responses": {
		"201": {
			"description": "201 response",
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../../../components/block-rule-object.json"
					}
				}
			}
		}
	}
}
