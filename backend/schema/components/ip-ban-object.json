{
	"type": "object",
	"description": "Dynamic IP Ban object",
	"required": [
		"id",
		"created_on",
		"modified_on",
		"expires_on",
		"ip",
		"action",
		"reason",
		"source",
		"meta"
	],
	"properties": {
		"id": {
			"$ref": "../common.json#/properties/id"
		},
		"created_on": {
			"$ref": "../common.json#/properties/created_on"
		},
		"modified_on": {
			"$ref": "../common.json#/properties/modified_on"
		},
		"expires_on": {
			"type": "string",
			"format": "date-time",
			"example": "2026-11-13T13:30:00.000Z"
		},
		"ip": {
			"type": "string",
			"minLength": 1,
			"maxLength": 45,
			"example": "203.0.113.10"
		},
		"action": {
			"type": "integer",
			"enum": [403, 404, 444],
			"example": 403
		},
		"reason": {
			"type": "string",
			"maxLength": 500,
			"example": "fail2ban sshd"
		},
		"source": {
			"type": "string",
			"minLength": 1,
			"maxLength": 64,
			"example": "fail2ban"
		},
		"meta": {
			"type": "object"
		}
	}
}
